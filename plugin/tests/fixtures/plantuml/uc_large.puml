@startuml
left to right direction
skinparam packageStyle rectangle
actor Customer
actor "Shop Assistant" as SA
actor Manager
actor "Payment Provider" as PP <<system>>
rectangle "Online Shop" {
  usecase "Browse catalog" as UC1
  usecase "Search products" as UC2
  usecase "Add to cart" as UC3
  usecase "Check out" as UC4
  usecase "Pay" as UC5
  usecase "Track order" as UC6
  usecase "Manage products" as UC7
  usecase "Process returns" as UC8
  usecase "Create reports" as UC9
  usecase "Apply coupon" as UC10
  usecase "Log in" as UC11
  usecase "Register" as UC12
}
Customer --> UC1
Customer --> UC3
Customer --> UC4
Customer --> UC6
Customer --> UC12
UC1 ..> UC2 : <<extend>>
UC4 ..> UC5 : <<include>>
UC4 ..> UC11 : <<include>>
UC4 ..> UC10 : <<extend>>
UC5 --> PP
SA --> UC7
SA --> UC8
UC8 ..> UC11 : <<include>>
Manager --> UC9
Manager --> UC7
SA <|-- Manager
note right of UC10 : valid coupons only
@enduml
