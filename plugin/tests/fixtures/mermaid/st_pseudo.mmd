stateDiagram-v2
    state fork_state <<fork>>
    state join_state <<join>>
    state if_state <<choice>>
    [*] --> fork_state
    fork_state --> A
    fork_state --> B
    A --> join_state
    B --> join_state
    join_state --> if_state
    if_state --> Good : if n < 0
    if_state --> Bad : if n >= 0
    Good --> [*]
    Bad --> [*]
